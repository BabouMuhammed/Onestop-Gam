generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CEO
  FINANCE
  MANAGER
  CASHIER
}

enum LocationType {
  SHELF
  FLOOR
  COLD_STORAGE
  TABLE
  OTHER
}

enum Unit {
  PIECE
  PACK
  BOX
  BAG
  SACHET
  ROLL
  CYLINDER
  CARTON
  BOTTLE
  KG
  LITRE
}

enum MovementType {
  OPENING
  ADJUSTMENT
  COUNT
  RECEIPT
  RECEIPT_REVERSAL
  SALE
  SALE_VOID
  DAMAGE
  CONTRACT_DELIVERY
  CONTRACT_DELIVERY_REVERSAL
}

enum ContractType {
  FIXED_SUPPLY
  ONGOING_SUPPLY
  PROJECT
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DamageReason {
  BROKEN
  EXPIRED
  SPOILED
  MISSING
  OTHER
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CHEQUE
}

/// A business division. Display names live here and nowhere else.
model Division {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  skuPrefix     String
  nextSkuNumber Int      @default(1)
  nextReceiptNumber Int  @default(1)
  nextSaleNumber Int     @default(1)
  nextDamageNumber Int   @default(1)
  nextContractNumber Int @default(1)
  nextOrderNumber Int    @default(1)
  nextDeliveryNumber Int @default(1)
  createdAt     DateTime @default(now())

  users     User[]
  locations Location[]
  products  Product[]
  movements StockMovement[]
  suppliers Supplier[]
  receipts  StockReceipt[]
  customers Customer[]
  sales     Sale[]
  payments  Payment[]
  damages   DamageReport[]
  contracts Contract[]
  priceRequests PriceChangeRequest[]
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  name               String
  passwordHash       String
  role               Role
  /// Null for CEO and Finance, who work across both divisions.
  divisionId         String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  division Division? @relation(fields: [divisionId], references: [id])
  sessions Session[]
}

model Session {
  id         String   @id @default(uuid())
  /// SHA-256 of the cookie value. The raw token is never stored.
  tokenHash  String   @unique
  userId     String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Location {
  id         String       @id @default(uuid())
  divisionId String
  name       String
  type       LocationType @default(SHELF)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())

  division  Division        @relation(fields: [divisionId], references: [id])
  levels    StockLevel[]
  movements StockMovement[]
  receiptLines StockReceiptLine[]
  damages      DamageReport[]

  @@unique([divisionId, name])
}

model Product {
  id           String   @id @default(uuid())
  divisionId   String
  sku          String
  name         String
  /// The code printed on the pack, read by a scanner at the till.
  barcode      String?
  unit         Unit     @default(PIECE)
  /// Pieces inside one counted unit, e.g. 50 for a pack of 50. Null when counted singly.
  packSize     Int?
  /// Size attribute such as 1", DN 100 or 50mm.
  size         String?
  /// Null until a manager sets a price. A product without a price cannot be sold.
  sellingPrice Decimal? @db.Decimal(12, 2)
  /// Unit cost on the most recent receipt that has not been reversed. Null until stock is received.
  costPrice    Decimal? @db.Decimal(12, 2)
  tracksExpiry Boolean  @default(false)
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  division     Division        @relation(fields: [divisionId], references: [id])
  levels       StockLevel[]
  movements    StockMovement[]
  priceRequests PriceChangeRequest[]
  priceChanges PriceChange[]
  receiptLines StockReceiptLine[]
  saleLines    SaleLine[]
  damages      DamageReport[]
  contractItems ContractItem[]

  @@unique([divisionId, sku])
  @@unique([divisionId, name])
  @@unique([divisionId, barcode])
}

/// Quantity of one product at one location. A database CHECK keeps it at zero or above.
model StockLevel {
  id         String   @id @default(uuid())
  productId  String
  locationId String
  quantity   Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@index([locationId])
}

/// Append-only ledger. Every change to a StockLevel writes one row here in the same
/// transaction. A database trigger rejects UPDATE and DELETE.
model StockMovement {
  id            String       @id @default(uuid())
  divisionId    String
  productId     String
  locationId    String
  type          MovementType
  quantityDelta Decimal      @db.Decimal(14, 3)
  balanceAfter  Decimal      @db.Decimal(14, 3)
  note          String?
  userId        String?
  /// Set on movements written by a stock receipt or its reversal.
  receiptId     String?
  /// Set on movements written by a sale or its void.
  saleId        String?
  /// Set on the movement written when a damage report is approved.
  damageId      String?
  /// Set on movements written by a contract delivery or its reversal.
  deliveryId    String?
  createdAt     DateTime     @default(now())

  division Division      @relation(fields: [divisionId], references: [id])
  product  Product       @relation(fields: [productId], references: [id])
  location Location      @relation(fields: [locationId], references: [id])
  receipt  StockReceipt? @relation(fields: [receiptId], references: [id])
  sale     Sale?         @relation(fields: [saleId], references: [id])
  damage   DamageReport? @relation(fields: [damageId], references: [id])
  delivery ContractDelivery? @relation(fields: [deliveryId], references: [id])

  @@index([productId, createdAt])
  @@index([divisionId, createdAt])
}

model Supplier {
  id          String   @id @default(uuid())
  divisionId  String
  name        String
  contactName String?
  phone       String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  division Division       @relation(fields: [divisionId], references: [id])
  receipts StockReceipt[]

  @@unique([divisionId, name])
}

/// Stock received from a supplier. Posted receipts are never edited or deleted, only
/// reversed; a database trigger rejects UPDATE and DELETE.
model StockReceipt {
  id         String   @id @default(uuid())
  divisionId String
  /// Goods received number, e.g. QF-GRN-00012.
  number     String
  supplierId String
  receivedOn DateTime @db.Date
  /// The supplier's invoice or delivery note number.
  reference  String?
  note       String?
  /// Sum of the line costs, computed by the server.
  totalCost  Decimal  @db.Decimal(14, 2)
  userId     String
  createdAt  DateTime @default(now())

  division  Division              @relation(fields: [divisionId], references: [id])
  supplier  Supplier              @relation(fields: [supplierId], references: [id])
  lines     StockReceiptLine[]
  reversal  StockReceiptReversal?
  movements StockMovement[]

  @@unique([divisionId, number])
  @@index([divisionId, receivedOn])
  @@index([supplierId])
}

model StockReceiptLine {
  id          String    @id @default(uuid())
  receiptId   String
  position    Int
  productId   String
  locationId  String
  quantity    Decimal   @db.Decimal(14, 3)
  unitCost    Decimal   @db.Decimal(12, 2)
  lineCost    Decimal   @db.Decimal(14, 2)
  batchNumber String?
  expiryDate  DateTime? @db.Date

  receipt  StockReceipt @relation(fields: [receiptId], references: [id])
  product  Product      @relation(fields: [productId], references: [id])
  location Location     @relation(fields: [locationId], references: [id])

  @@index([receiptId])
  @@index([productId])
}

/// One per reversed receipt. The unique receiptId makes a second reversal impossible.
model StockReceiptReversal {
  id        String   @id @default(uuid())
  receiptId String   @unique
  reason    String
  userId    String
  createdAt DateTime @default(now())

  receipt StockReceipt @relation(fields: [receiptId], references: [id])
}

model Customer {
  id            String   @id @default(uuid())
  divisionId    String
  name          String
  phone         String?
  address       String?
  notes         String?
  /// Only a manager or the CEO can turn this on. Without it, every sale to this customer is paid in full.
  creditAllowed Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  division  Division   @relation(fields: [divisionId], references: [id])
  sales     Sale[]
  contracts Contract[]

  @@index([divisionId, name])
}

/// A posted sale. Never edited or deleted, only voided; a database trigger rejects UPDATE and DELETE.
model Sale {
  id           String   @id @default(uuid())
  divisionId   String
  /// Receipt number, e.g. QF-S-00042.
  number       String
  customerId   String?
  /// Who rang up the sale.
  userId       String
  /// Sum of the line totals, computed by the server from its own prices.
  total        Decimal  @db.Decimal(14, 2)
  /// Cash handed over, when cash was part of the payment.
  cashTendered Decimal? @db.Decimal(14, 2)
  changeGiven  Decimal  @default(0) @db.Decimal(14, 2)
  note         String?
  createdAt    DateTime @default(now())

  division  Division        @relation(fields: [divisionId], references: [id])
  customer  Customer?       @relation(fields: [customerId], references: [id])
  lines     SaleLine[]
  payments  Payment[]
  void      SaleVoid?
  movements StockMovement[]

  @@unique([divisionId, number])
  @@index([divisionId, createdAt])
  @@index([customerId])
  @@index([userId])
}

model SaleLine {
  id        String   @id @default(uuid())
  saleId    String
  position  Int
  productId String
  quantity  Decimal  @db.Decimal(14, 3)
  /// The product's selling price when the sale was posted.
  unitPrice Decimal  @db.Decimal(12, 2)
  lineTotal Decimal  @db.Decimal(14, 2)
  /// The product's cost price when the sale was posted, for margin reports. Null if never received.
  unitCost  Decimal? @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

/// One per voided sale. The unique saleId makes a second void impossible.
model SaleVoid {
  id        String   @id @default(uuid())
  saleId    String   @unique
  reason    String
  userId    String
  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])
}

/// Money received against a sale, at the till or later. Append-only. A refund on a
/// voided sale is a row with a negative amount.
model Payment {
  id         String        @id @default(uuid())
  divisionId String
  saleId     String
  method     PaymentMethod
  amount     Decimal       @db.Decimal(14, 2)
  /// Mobile money or bank transaction reference, or cheque number.
  reference  String?
  userId     String
  createdAt  DateTime      @default(now())

  division Division @relation(fields: [divisionId], references: [id])
  sale     Sale     @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([divisionId, createdAt])
}

/// Stock found broken, expired, spoiled or missing. Reported by anyone at the shop, written off
/// only when a manager who did not report it (or the CEO) approves. Never edited or deleted.
model DamageReport {
  id         String       @id @default(uuid())
  divisionId String
  /// e.g. QF-DMG-00003
  number     String
  productId  String
  locationId String
  quantity   Decimal      @db.Decimal(14, 3)
  reason     DamageReason
  note       String
  reportedBy String
  createdAt  DateTime     @default(now())

  division  Division        @relation(fields: [divisionId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  location  Location        @relation(fields: [locationId], references: [id])
  decision  DamageDecision?
  movements StockMovement[]

  @@unique([divisionId, number])
  @@index([divisionId, createdAt])
}

/// One per report. The unique damageId makes a second decision impossible.
model DamageDecision {
  id        String   @id @default(uuid())
  damageId  String   @unique
  approved  Boolean
  note      String?
  /// Cost price of one unit when approved, so the loss keeps its value if costs change later.
  unitCost  Decimal? @db.Decimal(12, 2)
  userId    String
  createdAt DateTime @default(now())

  damage DamageReport @relation(fields: [damageId], references: [id])
}

/// An agreement to supply a customer. Fixed supply and project contracts agree quantities up
/// front; ongoing supply agrees prices and the customer orders as needed. The header can be
/// edited (with an audit record); orders, deliveries and payments are append-only.
model Contract {
  id          String         @id @default(uuid())
  divisionId  String
  /// e.g. LGB-CON-0003
  number      String
  customerId  String
  type        ContractType
  title       String
  startDate   DateTime       @db.Date
  endDate     DateTime?      @db.Date
  /// Delivery address or project site.
  siteAddress String?
  notes       String?
  status      ContractStatus @default(ACTIVE)
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  division   Division           @relation(fields: [divisionId], references: [id])
  customer   Customer           @relation(fields: [customerId], references: [id])
  items      ContractItem[]
  orders     ContractOrder[]
  deliveries ContractDelivery[]
  payments   ContractPayment[]

  @@unique([divisionId, number])
  @@index([divisionId, status])
  @@index([customerId])
}

model ContractItem {
  id             String   @id @default(uuid())
  contractId     String
  position       Int
  productId      String
  agreedPrice    Decimal  @db.Decimal(12, 2)
  /// Total agreed over the contract. Null on ongoing supply contracts.
  agreedQuantity Decimal? @db.Decimal(14, 3)

  contract   Contract            @relation(fields: [contractId], references: [id])
  product    Product             @relation(fields: [productId], references: [id])
  orderLines ContractOrderLine[]

  @@unique([contractId, productId])
}

model ContractOrder {
  id         String    @id @default(uuid())
  contractId String
  /// e.g. QF-ORD-00012
  number     String
  orderedOn  DateTime  @db.Date
  requiredBy DateTime? @db.Date
  /// The customer's own order number.
  reference  String?
  note       String?
  userId     String
  createdAt  DateTime  @default(now())

  contract     Contract                 @relation(fields: [contractId], references: [id])
  lines        ContractOrderLine[]
  deliveries   ContractDelivery[]
  cancellation ContractOrderCancellation?

  @@index([contractId])
}

model ContractOrderLine {
  id             String  @id @default(uuid())
  orderId        String
  contractItemId String
  productId      String
  quantity       Decimal @db.Decimal(14, 3)
  /// The agreed price when the order was placed.
  unitPrice      Decimal @db.Decimal(12, 2)

  order         ContractOrder          @relation(fields: [orderId], references: [id])
  contractItem  ContractItem           @relation(fields: [contractItemId], references: [id])
  deliveryLines ContractDeliveryLine[]

  @@index([orderId])
}

/// Closes an order: whatever was not yet delivered will not be.
model ContractOrderCancellation {
  id        String   @id @default(uuid())
  orderId   String   @unique
  reason    String
  userId    String
  createdAt DateTime @default(now())

  order ContractOrder @relation(fields: [orderId], references: [id])
}

model ContractDelivery {
  id          String   @id @default(uuid())
  divisionId  String
  contractId  String
  orderId     String
  /// Delivery note number, e.g. LGB-DN-00007
  number      String
  deliveredOn DateTime @db.Date
  /// Who signed for it at the customer's end.
  receivedBy  String?
  note        String?
  /// Sum of the line totals, computed by the server.
  value       Decimal  @db.Decimal(14, 2)
  userId      String
  createdAt   DateTime @default(now())

  contract  Contract                 @relation(fields: [contractId], references: [id])
  order     ContractOrder            @relation(fields: [orderId], references: [id])
  lines     ContractDeliveryLine[]
  reversal  ContractDeliveryReversal?
  movements StockMovement[]

  @@unique([divisionId, number])
  @@index([contractId])
}

model ContractDeliveryLine {
  id          String  @id @default(uuid())
  deliveryId  String
  orderLineId String
  productId   String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(14, 2)

  delivery  ContractDelivery  @relation(fields: [deliveryId], references: [id])
  orderLine ContractOrderLine @relation(fields: [orderLineId], references: [id])

  @@index([deliveryId])
  @@index([orderLineId])
}

model ContractDeliveryReversal {
  id         String   @id @default(uuid())
  deliveryId String   @unique
  reason     String
  userId     String
  createdAt  DateTime @default(now())

  delivery ContractDelivery @relation(fields: [deliveryId], references: [id])
}

/// Money collected from the customer against a contract. Append-only.
model ContractPayment {
  id         String        @id @default(uuid())
  divisionId String
  contractId String
  method     PaymentMethod
  amount     Decimal       @db.Decimal(14, 2)
  reference  String?
  receivedOn DateTime      @db.Date
  note       String?
  userId     String
  createdAt  DateTime      @default(now())

  contract Contract @relation(fields: [contractId], references: [id])

  @@index([contractId])
}

model PriceChange {
  id        String   @id @default(uuid())
  productId String
  oldPrice  Decimal? @db.Decimal(12, 2)
  newPrice  Decimal  @db.Decimal(12, 2)
  userId    String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
}

/// A manager's request to change a price that is already set. The CEO approves or
/// rejects it; until then the old price stands. Append-only.
model PriceChangeRequest {
  id          String   @id @default(uuid())
  divisionId  String
  productId   String
  /// The price when the request was made. Approval is refused if it has moved since.
  oldPrice    Decimal  @db.Decimal(12, 2)
  newPrice    Decimal  @db.Decimal(12, 2)
  reason      String?
  requestedBy String
  createdAt   DateTime @default(now())

  division Division              @relation(fields: [divisionId], references: [id])
  product  Product               @relation(fields: [productId], references: [id])
  decision PriceChangeDecision?

  @@index([divisionId, createdAt])
  @@index([productId, createdAt])
}

/// One per request. The unique requestId makes a second decision impossible.
model PriceChangeDecision {
  id        String   @id @default(uuid())
  requestId String   @unique
  approved  Boolean
  note      String?
  userId    String
  createdAt DateTime @default(now())

  request PriceChangeRequest @relation(fields: [requestId], references: [id])
}

/// Makes a repeated submission (double click, retry after a dropped connection) a no-op.
model IdempotencyKey {
  id        String   @id @default(uuid())
  userId    String
  key       String
  response  Json?
  createdAt DateTime @default(now())

  @@unique([userId, key])
}

/// Append-only. A database trigger rejects UPDATE and DELETE, for every role.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userName   String?
  divisionId String?
  action     String
  entity     String
  entityId   String?
  summary    String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([divisionId, createdAt])
}
