# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Never point a development machine at the production database.
DATABASE_URL=postgresql://onestop:onestop@localhost:5432/onestop_dev
# Used only by the automated tests. The test run TRUNCATES this database.
TEST_DATABASE_URL=postgresql://onestop:onestop@localhost:5432/onestop_test

NODE_ENV=development
PORT=4000
# The browser origin allowed to call the API (the Vite dev server by default).
WEB_ORIGIN=http://localhost:5173
# Hosting only: serve the built web app from the API (one service), and the number of proxies in front.
# WEB_DIST=../web/dist
# TRUST_PROXY=1

# Sessions
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# First administrator, created by `npm run db:seed`. There is no default password:
# choose one of at least 10 characters. It must be changed at first sign-in.
SEED_ADMIN_USERNAME=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
