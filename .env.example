# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Never point a development machine at the production database.
DATABASE_URL=postgresql://onestop_dev@127.0.0.1:5432/onestop_gam_dev
# Add the existing user's URL-encoded password locally. Never commit it.
# Used only by the automated tests. The test run TRUNCATES this database.
# Alternatively put TEST_DATABASE_URL in ignored .env.integration. Only loopback
# onestop*_test databases with an explicit password and public schema are accepted.
TEST_DATABASE_URL=

NODE_ENV=development
PORT=4000
# The browser origin allowed to call the API (the Vite dev server by default).
WEB_ORIGIN=http://localhost:5173

# Sessions
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# First administrator, created by `npm run db:seed`. There is no default password:
# choose one of at least 10 characters. It must be changed at first sign-in.
SEED_ADMIN_USERNAME=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
